rules_version = '2';

// Family Household Tracker — Firestore security rules.
//
// Access is decided by settings/config.accessRoles, a map of
//   lowercased Google email -> 'admin' | 'contributor' | 'viewer' | 'denied'
// that the app keeps in sync with settings/config.authorizedUsers whenever
// an admin saves (see buildAccessRoles() in index.html).
//
//   admin        read + write everything, manage settings and access
//   contributor  read everything; add/edit/delete records, events, home items
//   viewer       read everything; may only write their OWN memberPrefs doc
//   anyone else  nothing
//
// Per-person data (push device tokens, notification-type choices) lives in
// memberPrefs/{lowercased email}, readable/writable only by that person or an
// admin (Phase 2, S1). It used to live inline on settings/config.members,
// where any signed-in member could write the *whole* `members` array —
// including every other member's device tokens and names, not just their
// own — because the old rule only checked which top-level settings/config
// keys changed, never what changed inside `members`.
//
// The reminder job (scripts/send-reminders.js) uses the Admin SDK, which
// bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function myRole() {
      return request.auth != null && request.auth.token.email_verified == true
        ? get(/databases/$(database)/documents/settings/config).data
            .get('accessRoles', {})
            .get(request.auth.token.email.lower(), 'none')
        : 'none';
    }
    function isMember()  { return myRole() in ['admin', 'contributor', 'viewer']; }
    function canWrite()  { return myRole() in ['admin', 'contributor']; }
    function isAdmin()   { return myRole() == 'admin'; }
    function myEmail()   { return request.auth.token.email.lower(); }

    match /settings/config {
      allow read: if isMember();

      // Only admins write settings, and never into a state with no admin.
      // No one can create the doc from the app: if it is ever lost,
      // recreate it in the Firebase console (see SECURITY.md).
      allow update: if isAdmin()
        && request.resource.data.get('accessRoles', {}).values().hasAny(['admin']);
    }

    // Push device tokens + notification-type choices, one doc per person,
    // keyed by their own lowercased sign-in email (S1). A member may only
    // read/write their own doc; an admin may read/write anyone's (e.g. to
    // prune a departed member's devices from the Admin screen).
    function validPrefs() {
      let d = request.resource.data;
      return d.keys().hasOnly(['fcmTokens', 'notifyTypes', 'updatedAt'])
        && d.get('fcmTokens', []) is list && d.get('fcmTokens', []).size() <= 20
        && d.get('notifyTypes', []) is list && d.get('notifyTypes', []).size() <= 12;
    }
    match /memberPrefs/{email} {
      allow read: if isAdmin() || (isMember() && email == myEmail());
      allow create, update: if (isAdmin() || (isMember() && email == myEmail())) && validPrefs();
      allow delete: if isAdmin();
    }

    match /autoRecords/{id} {
      allow read: if isMember();
      allow create, update, delete: if canWrite();
    }
    match /homeItems/{id} {
      allow read: if isMember();
      allow create, update, delete: if canWrite();
    }
    match /events/{id} {
      allow read: if isMember();
      allow create, update, delete: if canWrite();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
