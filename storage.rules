rules_version = '2';

// Family Household Tracker — Cloud Storage rules for receipt/attachment uploads.
// Roles come from the same settings/config.accessRoles map as firestore.rules.
// Phase 3 (S3): records now store the Storage *path*, not a minted download
// URL — the app calls getDownloadURL() lazily when a file is actually
// opened, so these `read` rules are checked on every open, not just once at
// upload time. (Records saved before this change still hold an old-style
// download URL; the app opens those directly, same as always — anyone
// holding one of those older URLs can still open that file regardless of
// their current role, since a URL minted under the old scheme carries its
// own access token rather than going through these rules.)
service firebase.storage {
  match /b/{bucket}/o {

    function myRole() {
      return request.auth != null && request.auth.token.email_verified == true
        ? firestore.get(/databases/(default)/documents/settings/config).data
            .get('accessRoles', {})
            .get(request.auth.token.email.lower(), 'none')
        : 'none';
    }

    // Uploads land at receipts/{uid}/{auto|home}_{timestamp}_{filename}.
    match /receipts/{uid}/{fileName} {
      allow read: if myRole() in ['admin', 'contributor', 'viewer'];
      allow create, update: if request.auth.uid == uid
        && myRole() in ['admin', 'contributor']
        && request.resource.size <= 25 * 1024 * 1024           // matches MAX_FILE_BYTES
        && !request.resource.contentType.matches('text/html.*|.*javascript.*');
      allow delete: if myRole() == 'admin';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
